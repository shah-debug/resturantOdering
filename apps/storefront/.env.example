# Copy to apps/storefront/.env.local (git-ignored).
# Where the API runs; the storefront forwards /api/* requests there.
API_ORIGIN=http://localhost:4000
# Public address of this site, used for canonical links, the sitemap and robots.txt.
# Required in production, e.g. https://order.example.com
SITE_URL=http://localhost:3001
# How long (seconds) restaurant menus are cached by the storefront server. 0 disables caching.
STOREFRONT_REVALIDATE_SECONDS=30
