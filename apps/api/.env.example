NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=1

# --- Database (Supabase development project) --------------------------------
# Copy hosts from Supabase Dashboard -> Connect. Percent-encode special characters in the password.
# Runtime connection for the long-running API: Supavisor session pooler (port 5432).
# Do not add ?sslmode=... when DATABASE_SSL_CA_PATH is set.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<index>-<region>.pooler.supabase.com:5432/postgres
# Supabase CA certificate (Dashboard -> Database Settings -> SSL Configuration -> Download certificate).
# Required in production; strongly recommended in development.
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# Migration connection for the Prisma CLI only. Either the direct connection (IPv6):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt
# or the session pooler (IPv4):
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-<index>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_HEALTH_TIMEOUT_MS=2000

# --- Browser security ---------------------------------------------------------
# Exact origins allowed to send state-changing requests (CSRF check). https only in production.
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# Base URL used in email links.
DASHBOARD_URL=http://localhost:3000

# --- Sessions and sign-in protection ------------------------------------------
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15

# --- Rate limits (per client IP) ----------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Email --------------------------------------------------------------------
# "log" prints emails (including links) to the API log; development only, rejected in production.
MAIL_TRANSPORT=log
MAIL_FROM=Restaurant Platform <no-reply@localhost>
# Required when MAIL_TRANSPORT=resend
# RESEND_API_KEY=
