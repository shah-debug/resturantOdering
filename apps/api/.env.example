# Copy this file to apps/api/.env and fill in the values marked "FILL IN".
# apps/api/.env is git-ignored. Never commit real passwords or keys.

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
PORT=4000
# Number of proxies in front of the API (the Next.js apps count as one).
TRUST_PROXY_HOPS=1

# =============================================================================
# Database: Supabase DEVELOPMENT project (never production)
# Supabase Dashboard -> your project -> "Connect" button.
# Replace <project-ref>, <password>, <index> and <region> with your values.
# If the password has special characters (@ : / # ?), percent-encode them,
# e.g. @ -> %40, # -> %23.
# =============================================================================

# FILL IN: "Session pooler" connection string (port 5432). Used by the API at runtime.
# Do not add ?sslmode=... here.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<index>-<region>.pooler.supabase.com:5432/postgres

# FILL IN: used only by Prisma for migrations. Same session pooler URL, with SSL verification.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-<index>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt

# Supabase SSL certificate: Dashboard -> Project Settings -> Database -> SSL Configuration
# -> "Download certificate". Save it as apps/api/certs/supabase-ca.crt, then uncomment:
# DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_HEALTH_TIMEOUT_MS=2000

# =============================================================================
# Browser security
# =============================================================================
# Websites allowed to send changes to the API (dashboard and storefront).
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# Base address used in email links.
DASHBOARD_URL=http://localhost:3000

# =============================================================================
# Sign-in and sessions
# =============================================================================
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=24
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15

# =============================================================================
# Rate limits (per IP address)
# =============================================================================
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Public storefront menu reads have their own, larger budget (they come from the storefront server).
STOREFRONT_RATE_LIMIT_MAX_REQUESTS=600

# =============================================================================
# Email
# "log" prints emails (with verification/reset links) in the API terminal.
# Good for development; not allowed in production.
# =============================================================================
MAIL_TRANSPORT=log
MAIL_FROM=Restaurant Platform <no-reply@localhost>
# For real emails, send through your own SMTP server (nodemailer):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# Port 587 = STARTTLS, port 465 = SSL (SMTP_SECURE defaults to true on 465).
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# Gmail: use an App Password (Google Account -> Security -> App passwords), not your login password.
# SMTP_PASSWORD=
# MAIL_FROM must be an address your SMTP account is allowed to send from, e.g.
# MAIL_FROM=Restaurant Platform <you@gmail.com>

# =============================================================================
# Menu image storage
# "local" saves images in apps/api/uploads (development only).
# =============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# For Supabase Storage (required in production):
# STORAGE_DRIVER=supabase
# STORAGE_BUCKET=menu-images
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Order tracking links
# Signs the private tracking link customers get after ordering. Changing it
# invalidates existing links. Required in production (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
# ORDER_TRACKING_SECRET=
